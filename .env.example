# Copy to .env for local development; set the same names as real environment
# variables / secrets on the server. Never commit .env.
# The server logs a one-line warning at startup naming any REQUIRED variable
# that is missing (src/lib/env.server.ts). It never prints values.

# =============================================================================
# REQUIRED
# =============================================================================

# --- Supabase (your own project: Settings -> API) ----------------------------
# Browser-visible: baked into the client bundle at BUILD time.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side copies of the same two, plus the service-role key (SECRET: it
# bypasses row-level security; server only).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- This deployment ---------------------------------------------------------
# Public origin (no trailing slash), used for links in emails and unsubscribe URLs.
APP_BASE_URL=http://localhost:8080

# --- Scheduled sweep (nudges, check-ins, email delivery, crisis escalation) --
# A scheduler must call /api/public/hooks/evaluate-nudges every 1-2 minutes with
# header "x-sweep-secret: <this value>" (see docs/LAUNCH_CHECKLIST.md).
# Use a long random value, e.g. `openssl rand -hex 32`.
NUDGE_SWEEP_SECRET=

# --- AI ----------------------------------------------------------------------
OPENROUTER_API_KEY=            # companion, summaries, digests, crisis classifier

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=             # gets crisis and human-support alerts

# =============================================================================
# OPTIONAL
# =============================================================================

OPENAI_API_KEY=                # voice notes (transcription) and live voice calls
EMAIL_FROM=Calm AI <hello@calmai.site>
EMAIL_UNSUBSCRIBE_SECRET=      # optional but recommended (long random string); if empty a key is derived from the service-role key. Changing it invalidates links in already-sent emails

# --- Vercel Cron only (not needed with the default pg_cron scheduler) --------
# Must equal NUDGE_SWEEP_SECRET; Vercel sends it as "Authorization: Bearer".
CRON_SECRET=

# --- Push notifications ------------------------------------------------------
EXPO_ACCESS_TOKEN=             # only if Expo "enhanced push security" is on
FCM_SERVICE_ACCOUNT_JSON=      # only for raw-FCM clients; the Expo app doesn't need it

# --- Feature flags and limits ------------------------------------------------
CHAT_CHECKIN_ENABLED=          # true -> companion messages people quiet for ~12h
POST_CRISIS_FOLLOWUP_ENABLED=  # true -> gentle follow-up ~24h after a crisis event
LIVE_SESSIONS_OPEN_BETA=       # see src/lib/call-session.server.ts
FREE_INTRO_MESSAGE_CAP=15      # free members' first-conversation messages
CHAT_DAILY_MESSAGE_CAP=200     # Pro
PREMIUM_DAILY_MESSAGE_CAP=500
VOICE_COST_PER_MINUTE_USD=     # voice cost accounting override

# --- Payments (optional; off by default) -------------------------------------
# Name of the payment gateway to use. Unset = payments off (plans page says
# "Payments launching soon"). No gateway ships yet: see docs/PAYMENTS.md for
# how to add one; its own secrets are documented there.
# PAYMENT_PROVIDER=
