# Copy to .env for local development; set the same names as real environment
# variables / secrets on the server. Never commit .env.

# --- Supabase (your own project: Settings → API) ----------------------------
# Browser-visible: baked into the client bundle at build time.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side copies of the same two, plus the service-role key (SECRET: it
# bypasses row-level security; server only).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- This deployment ---------------------------------------------------------
# Public origin, used for links in emails and the unsubscribe URL.
APP_BASE_URL=http://localhost:8080

# --- AI ----------------------------------------------------------------------
OPENROUTER_API_KEY=            # companion, summaries, digests, crisis classifier
OPENAI_API_KEY=                # voice notes (transcription) and live voice calls

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Kalm <hello@your-domain.com>
ADMIN_ALERT_EMAIL=             # gets crisis and human-support alerts
EMAIL_UNSUBSCRIBE_SECRET=      # optional; derived from the service-role key if empty

# --- Scheduled sweep (nudges, check-ins, email delivery) ---------------------
# A scheduler must POST /api/public/hooks/evaluate-nudges every 1-2 minutes
# with header "x-sweep-secret: <this value>" (see docs/SELF_HOSTING.md).
NUDGE_SWEEP_SECRET=

# --- Push notifications (optional) -------------------------------------------
EXPO_ACCESS_TOKEN=             # only if Expo "enhanced push security" is on
FCM_SERVICE_ACCOUNT_JSON=      # only for raw-FCM clients; the Expo app doesn't need it

# --- Feature flags and limits (all optional) ---------------------------------
CHAT_CHECKIN_ENABLED=          # true → companion messages people quiet for ~12h
POST_CRISIS_FOLLOWUP_ENABLED=  # true → gentle follow-up ~24h after a crisis event
FREE_INTRO_MESSAGE_CAP=15      # free members' first-conversation messages
CHAT_DAILY_MESSAGE_CAP=200     # Pro
PREMIUM_DAILY_MESSAGE_CAP=500
